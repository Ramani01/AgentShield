{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    },
    "standard": {
      "format": "[%(asctime)s] [%(levelname)s] [%(name)s]: %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "agentshield": {
      "level": "INFO",
      "handlers": ["console"],
      "propagate": false
    }
  }
}
